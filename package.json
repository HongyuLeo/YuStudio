{
  "name": "yustudio",
  "version": "1.3.1",
  "private": true,
  "description": "Bilingual local music video studio with cinematic scenes and NVIDIA NVENC",
  "main": "src/desktop/main.cjs",
  "type": "module",
  "scripts": {
    "start": "node --import tsx src/server/index.ts",
    "dev": "node --import tsx src/server/index.ts",
    "desktop": "npm run build && electron .",
    "build": "tsc --noEmit && vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs && node --import tsx scripts/build-compositions.ts",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts",
    "demo": "node --import tsx scripts/create-demo.ts",
    "render:demo": "node --import tsx scripts/render-demo.ts",
    "dist:win": "npm run build && node scripts/prepare-binaries.cjs && electron-builder --win zip --x64"
  },
  "dependencies": {
    "@remotion/media": "4.0.532",
    "@remotion/player": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "express": "5.1.0",
    "multer": "2.0.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.532",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0",
    "@remotion/bundler": "4.0.532",
    "@resvg/resvg-js": "2.6.2",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.6",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "38.2.2",
    "electron-builder": "26.0.12",
    "esbuild": "0.25.10",
    "tsx": "4.20.6",
    "typescript": "5.9.2",
    "vite": "6.3.6"
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.2.0",
    "ffprobe-static": "3.1.0"
  },
  "build": {
    "appId": "studio.yustudio.local",
    "productName": "YuStudio",
    "asar": false,
    "asarUnpack": [
      "node_modules/@remotion/compositor-*/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "src/**/*",
      "public/**/*",
      "package.json",
      "remotion-dist/**/*",
      "licenses/**/*",
      "!node_modules/@remotion/compositor-linux-*/**",
      "!node_modules/ffmpeg-static/ffmpeg",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "public/demo",
        "to": "demo"
      },
      {
        "from": ".desktop-binaries",
        "to": "binaries"
      },
      {
        "from": ".desktop-media",
        "to": "media-tools"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "zip",
      "signAndEditExecutable": true,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "npmRebuild": false,
    "artifactName": "YuStudio-Windows-x64.${ext}"
  },
  "author": "YuStudio Contributors"
}
